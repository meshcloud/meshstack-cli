            "description": "201",
            "content": {
              "application/vnd.meshcloud.api.meshbuildingblock.v1.hal+json": {"schema": {"$ref": "#/components/schemas/blockV1"}},
              "application/vnd.meshcloud.api.meshbuildingblock.v2-preview.hal+json": {"schema": {"$ref": "#/components/schemas/blockV2"}}
            }
          },
          "400": {"description": "400", "content": {"application/json": {"schema": {"type": "object"}}}}
        }
      }
    },
