func (u {{.Name}}) MarshalJSONTo(enc *jsontext.Encoder) error {
	switch u.{{.DiscField}} {
{{- range .Cases}}
	case {{quote .Value}}:
		if u.{{.Field}} != nil {
			return json.MarshalEncode(enc, struct {
				Discriminator {{$type.DiscType}} `json:{{quote $type.DiscJSON}}`
				*{{.Type}} `json:",embed"`
			}{u.{{$type.DiscField}}, u.{{.Field}}})
		}
{{- end}}
	}
	return fmt.Errorf("{{.Name}} has no value for {{.DiscJSON}} %q", u.{{.DiscField}})
}

// UnmarshalJSONFrom leaves every variant nil for a {{.DiscJSON}} this client does not know yet.
func (u *{{.Name}}) UnmarshalJSONFrom(dec *jsontext.Decoder) error {
	raw, err := dec.ReadValue()
	if err != nil {
		return err
	}
	var discriminator struct {
		Value {{.DiscType}} `json:{{quote .DiscJSON}}`
	}
	if err := json.Unmarshal(raw, &discriminator); err != nil {
		return err
	}
	*u = {{.Name}}{ {{- .DiscField}}: discriminator.Value}
	switch discriminator.Value {
{{- range .Cases}}
	case {{quote .Value}}:
		u.{{.Field}} = new({{.Type}})
		return json.Unmarshal(raw, u.{{.Field}})
{{- end}}
	}
	return nil
}
